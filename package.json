{
  "name": "dsh-plugin-cue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "dsh-plugin-cue: a soft cue when an agent finishes a turn, and a brighter alert while an approval is waiting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzy816/dsh-plugin-cue.git"
  },
  "homepage": "https://github.com/wzy816/dsh-plugin-cue#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "sound",
    "chime",
    "cue"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
